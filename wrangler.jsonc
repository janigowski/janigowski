{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "janigowski",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-10",
	"workers_dev": false,
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"build": {
		"command": "WORKERS_CI=1 bun run build"
	}
}
